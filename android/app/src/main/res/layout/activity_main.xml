<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="false">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="12dp"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#B3000000"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/btn_pick"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_folder_open"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_file"
            app:tint="#FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/nothing_playing" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            app:tint="#FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#B3000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#E6EBF5"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#E6EBF5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Five controls, same as the desktop bar. Speed, tracks and stop are
             one tap away in the ⋯ menu at the top; a row of ten icons on a
             phone is a wall, not a control bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton android:id="@+id/btn_prev" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_prev" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous" />
            <ImageButton android:id="@+id/btn_play" android:layout_width="56dp" android:layout_height="56dp"
                android:src="@drawable/ic_play" android:background="@drawable/bg_play_button"
                android:contentDescription="@string/play" />
            <ImageButton android:id="@+id/btn_next" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_next" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next" />

            <View android:layout_width="16dp" android:layout_height="1dp" />

            <ImageButton android:id="@+id/btn_list" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_playlist" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/playlist" />
            <ImageButton android:id="@+id/btn_pip" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_pip" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/picture_in_picture" />
        </LinearLayout>
    </LinearLayout>

    <!-- Playlist panel -->
    <LinearLayout
        android:id="@+id/playlist_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F212151D"
        android:visibility="gone"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/playlist"
                android:textColor="#E6EBF5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_playlist_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlist_recycler"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</FrameLayout>